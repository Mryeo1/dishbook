# ---------------------------------------------------------------------------
# This template contains only required options.
# For the full list see docs/system/configuration.md in this repository.
# For local development prefer .env.example, which needs no database server.
# ---------------------------------------------------------------------------

# random secret key, use for example `base64 /dev/urandom | head -c50` to generate one
SECRET_KEY=

# your default timezone See https://timezonedb.com/time-zones for a list of timezones
TZ=Europe/Berlin

# allowed hosts (see documentation), must be set to your hostname(s)
ALLOWED_HOSTS=recipes.mydomain.com

# add only a database password if you want to run with the default postgres, otherwise change settings accordingly
DB_ENGINE=django.db.backends.postgresql
POSTGRES_HOST=db_recipes
POSTGRES_DB=djangodb
POSTGRES_PORT=5432
POSTGRES_USER=djangouser
POSTGRES_PASSWORD=
