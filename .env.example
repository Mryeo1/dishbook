# ---------------------------------------------------------------------------
# 本地开发用配置：复制成 .env 即可跑起来，不需要数据库服务。
#     cp .env.example .env
#
# 生产部署不要用这个文件，参考 .env.template 与 docs/DEPLOY.md。
# ---------------------------------------------------------------------------

# 仅用于本地。SECRET_KEY 泄露等于会话可伪造，上线前必须换成随机值：
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-key-change-before-deploying
DEBUG=1

# 用 127.0.0.1 与 localhost 都能访问；换成域名后记得同步 settings 的 CSRF 配置
ALLOWED_HOSTS=localhost,127.0.0.1

TZ=Asia/Shanghai

# 开发默认 SQLite，零依赖，数据落在项目根目录的 db.sqlite3。
# 要连 PostgreSQL 就换成 .env.template 里那段（DB_ENGINE=django.db.backends.postgresql
# 加上 POSTGRES_* 五项），并先建好库。
DB_ENGINE=django.db.backends.sqlite3

# 允许在登录页自助注册，方便本地多开几个账号试协作功能
ENABLE_SIGNUP=1

# 会话双规则（cookbook/helper/session_limits.py）
# 闲置 5 分钟后要重新登录；单次登录最长 3 小时，到点强制下线
SESSION_IDLE_TIMEOUT=300
SESSION_MAX_AGE=10800

# 同一个 127.0.0.1 上常有几个 Django 项目并存，cookie 不按端口隔离，
# 用默认名字会互相顶掉登录态，所以给个专属名字
SESSION_COOKIE_NAME=dishbook_sessionid

# 让 LiteLLM 用内置价格表，避免首次调用 AI 功能时联网拉取
LITELLM_LOCAL_MODEL_COST_MAP=True

# DEBUG=0 时由 Django 直接提供 /media/ 下的图片，否则菜谱配图会 404
GUNICORN_MEDIA=1
